# Cloudflare R2 (Worth the Ride /upload)
# Dashboard: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bluecollarvideoguys-videos
# Public bucket URL after enabling public access, e.g. https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=

# Legacy Vercel Blob (optional — old uploads may still live here)
BLOB_READ_WRITE_TOKEN=

# Contact form (Resend). FROM uses onboarding@resend.dev until the domain is verified.
CONTACT_TO_EMAIL=build@bluecollarvideoguys.com
RESEND_API_KEY=

# QR scan funnel (optional). Direct MP4 URLs. Drop the PDF at public/funnel/blueprint.pdf
# YouTube or MP4 URL — defaults to funnel YouTube film when unset
NEXT_PUBLIC_FUNNEL_INTRO_VIDEO_URL=
NEXT_PUBLIC_FUNNEL_FOLLOWUP_VIDEO_URL=

# Optional: protects GET /api/blob/list
UPLOAD_SECRET=
